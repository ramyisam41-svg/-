<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#138a55"><link rel="manifest" href="manifest.json"><title>ملك الطعمية</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f5f8f6;color:#17352a}.app{max-width:480px;margin:auto;min-height:100vh;background:#fff;padding-bottom:82px}
header{background:linear-gradient(135deg,#138a55,#0b6f45);color:#fff;padding:22px 18px;border-radius:0 0 26px 26px}.brand{font-size:28px;font-weight:800}.sub{opacity:.9;margin-top:5px}.status{display:inline-block;margin-top:12px;background:#d9f7e6;color:#08733f;padding:7px 12px;border-radius:20px;font-weight:700}
main{padding:16px}.card{background:#fff;border:1px solid #e5eee9;border-radius:18px;padding:15px;margin-bottom:13px;box-shadow:0 5px 18px #00000009}h2{font-size:20px;margin:4px 0 13px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.item{border:1px solid #dce9e2;border-radius:15px;padding:13px;text-align:center;background:#fff}.qty{font-size:18px;font-weight:800}.price{color:#138a55;font-weight:800;margin-top:5px}
.add{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid #edf2ef}.add:last-child{border:0}button{border:0;border-radius:13px;padding:12px 15px;font-weight:800;font-size:15px;cursor:pointer}.primary{background:#138a55;color:white;width:100%}.secondary{background:#e8f6ef;color:#08733f}.selected{outline:3px solid #8bd4ae;background:#f0fff6}.total{font-size:21px;font-weight:900;color:#138a55;text-align:center;margin:10px}
input,textarea{width:100%;padding:12px;border:1px solid #d7e5de;border-radius:12px;font-size:15px;margin:6px 0 10px;font-family:inherit}label{font-weight:700;font-size:14px}.notice{background:#fff7dc;border:1px solid #f1d47a;padding:12px;border-radius:14px;margin-bottom:12px}.ok{background:#eafaf1;border:1px solid #a7dfbf;color:#146b42;padding:12px;border-radius:14px}.err{background:#fff0f0;border:1px solid #efb1b1;color:#9b2424;padding:12px;border-radius:14px}.hidden{display:none}
nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(480px,100%);background:#fff;border-top:1px solid #dfeae4;display:grid;grid-template-columns:repeat(4,1fr);padding:9px 4px;z-index:4}nav button{background:none;color:#557067;padding:8px 2px;font-size:12px}nav button.active{color:#138a55;font-weight:900}
</style></head>
<body><div class="app">
<header><div class="brand">👑 ملك الطعمية</div><div class="sub">الولاية الشمالية - السليم - شرق كافتيريا ادروب</div><span id="status" class="status">جاري الاتصال...</span></header>
<main>
<section id="home"><div class="notice">🕕 السبت–الخميس: 6 صباحًا إلى 7 مساءً — الجمعة: مغلق</div>
<div id="apiMsg" class="hidden"></div>
<div class="card"><h2>🧆 اختر الكمية</h2><div id="qtyGrid" class="grid"></div></div>
<div class="card"><h2>🌶️ الإضافات</h2><div id="adds"></div></div>
<div class="card"><h2>👤 بيانات الطلب</h2><label>الاسم</label><input id="name" placeholder="اكتب اسمك"><label>رقم الهاتف</label><input id="phone" inputmode="tel" placeholder="مثال: 011xxxxxxx"><label>العنوان للتوصيل</label><textarea id="address" rows="2" placeholder="اكتب عنوانك بالتفصيل"></textarea><label>ملاحظات</label><textarea id="notes" rows="2" placeholder="أي ملاحظة للطلب (اختياري)"></textarea></div>
<div class="card"><button id="orderBtn" class="primary" onclick="placeOrder()">اطلب الآن</button><div id="total" class="total">الإجمالي: 3,000 جنيه</div></div></section>
<section id="orders" class="hidden"><div class="card"><h2>📦 طلباتي</h2><div id="orderBox">لا توجد طلبات بعد.</div></div></section>
<section id="contact" class="hidden"><div class="card"><h2>📞 تواصل معنا</h2><p>☎️ 0119948203</p><p>💬 واتساب: 0902163414</p><p>📍 الولاية الشمالية - السليم - شرق كافتيريا ادروب</p><p>🛵 رسوم التوصيل: 3,000 جنيه</p></div></section>
<section id="account" class="hidden"><div class="card"><h2>👑 حساب المحل</h2><p>الطلبات الآن تُحفظ مباشرة في قاعدة البيانات عبر API.</p><p>لوحة الإدارة الكاملة سنربطها في الخطوة التالية.</p></div></section>
</main><nav><button class="active" onclick="show('home',this)">🏠<br>الرئيسية</button><button onclick="show('orders',this)">📦<br>طلباتي</button><button onclick="show('contact',this)">📞<br>التواصل</button><button onclick="show('account',this)">👤<br>حسابي</button></nav></div>
<script>
const API_BASE=''; const DELIVERY_FEE=3000; let products=[],addons=[],selectedProduct=null,selectedAdds=new Set(),currentOrderId=null;
const $=id=>document.getElementById(id); const money=n=>Number(n||0).toLocaleString('ar-EG')+' جنيه';
async function api(path,opts={}){const r=await fetch(API_BASE+path,{headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});let data={};try{data=await r.json()}catch{}if(!r.ok)throw new Error(data.error||'تعذر الاتصال بالخادم');return data}
async function load(){try{const [shop,ps,as]=await Promise.all([api('/api/shop'),api('/api/products'),api('/api/addons')]);products=ps;addons=as;renderProducts();renderAddons();$('status').textContent=shop.open_now?'🟢 مفتوح ويستقبل الطلبات':'🔴 مغلق حالياً';calc();}catch(e){showMsg(e.message,'err')}}
function renderProducts(){const box=$('qtyGrid');box.innerHTML='';products.forEach(p=>{const b=document.createElement('button');b.className='item';b.innerHTML=`<div class="qty">${p.quantity} حبات</div><div class="price">${money(p.price)}</div>`;b.onclick=()=>{selectedProduct=p;[...box.children].forEach(x=>x.classList.remove('selected'));b.classList.add('selected');calc()};box.appendChild(b)})}
function renderAddons(){const box=$('adds');box.innerHTML='';addons.forEach(a=>{const d=document.createElement('div');d.className='add';d.innerHTML=`<span>${a.name} — ${money(a.price)}</span><button class="secondary">إضافة</button>`;d.querySelector('button').onclick=()=>{selectedAdds.has(a.id)?selectedAdds.delete(a.id):selectedAdds.add(a.id);d.querySelector('button').textContent=selectedAdds.has(a.id)?'تمت ✓':'إضافة';calc()};box.appendChild(d)})}
function calc(){const base=selectedProduct?selectedProduct.price:0;const addTotal=addons.filter(a=>selectedAdds.has(a.id)).reduce((s,a)=>s+a.price,0);$('total').textContent='الإجمالي: '+money(base+addTotal+DELIVERY_FEE)}
async function placeOrder(){if(!selectedProduct)return showMsg('اختر كمية الطعمية أولاً','err');const name=$('name').value.trim(),phone=$('phone').value.trim(),address=$('address').value.trim();if(!name||!phone||!address)return showMsg('أدخل الاسم ورقم الهاتف والعنوان أولاً','err');const btn=$('orderBtn');btn.disabled=true;btn.textContent='جاري إرسال الطلب...';try{const data=await api('/api/orders',{method:'POST',body:JSON.stringify({name,phone,address,order_type:'delivery',product_id:selectedProduct.id,quantity:1,addon_ids:[...selectedAdds],notes:$('notes').value.trim()})});currentOrderId=data.order_id;await showOrder(data.order_id);show('orders',document.querySelectorAll('nav button')[1]);showMsg('تم إرسال الطلب وحفظه في قاعدة البيانات ✓','ok');}catch(e){showMsg(e.message,'err')}finally{btn.disabled=false;btn.textContent='اطلب الآن'}}
async function showOrder(id){try{const o=await api('/api/orders/'+id);const status={new:'🟡 تم استلام الطلب',accepted:'🟢 تم قبول الطلب',preparing:'👨‍🍳 جاري التحضير',ready:'✅ جاهز',out_for_delivery:'🛵 في الطريق إليك',delivered:'🏁 تم التسليم',cancelled:'❌ ملغي'}[o.status]||o.status;$('orderBox').innerHTML=`<div class="card"><b>طلب #${o.id}</b><p>${o.items.map(i=>i.product_quantity+' حبات طعمية').join('، ')}</p><p>الإضافات: ${o.addons.length?o.addons.map(a=>a.name).join('، '):'لا توجد'}</p><p>التوصيل: ${money(o.delivery_fee)}</p><b>الإجمالي: ${money(o.total)}</b><p>${status}</p></div>`}catch(e){$('orderBox').textContent=e.message}}
function showMsg(msg,type){const el=$('apiMsg');el.className=type;el.textContent=msg;el.classList.remove('hidden')}
function show(id,btn){document.querySelectorAll('main section').forEach(s=>s.classList.add('hidden'));$(id).classList.remove('hidden');document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));btn.classList.add('active')}
load();
</script></body></html>
